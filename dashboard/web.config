<?xml version="1.0" encoding="UTF-8"?>
<!--
  Konfigurasi IIS untuk folder dashboard.
  - index.php menjadi dokumen default
  - daftar folder dimatikan
  - folder lib/ dan pages/ tidak bisa diakses langsung dari browser
  - file .ini/.log/.json/.sql tidak pernah disajikan

  Pastikan PHP sudah terpasang sebagai FastCGI handler di IIS dan
  autentikasi Anonymous diaktifkan (Basic Auth ditangani oleh index.php).
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="lib" />
          <add segment="pages" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".ini" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".json" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
