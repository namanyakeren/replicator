# Hasil build Rust
agent/target/
*.exe
*.pdb
*.rlib
*.rmeta

# Installer build outputs are intentionally tracked for site clones.
!installer/target/**

# Artefak rilis dist/ sengaja dilacak di git (binary + manifest versi)
!dist/*.exe

# Runtime agent
logs/
*.log
*.json.tmp

# Konfigurasi lokal berisi kredensial (gunakan template di config/)
config.ini
config/agent.ini
config/dashboard.ini
dashboard/config.ini

# Data runtime Podman
deploy/podman/.env
deploy/podman/config/
deploy/docker/config/
deploy/docker/.env

# Editor / OS
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store
