<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cadangan keamanan bila document root IIS tidak sengaja diarahkan ke
  folder proyek. Document root yang benar adalah folder "dashboard".
  File ini tidak mengubah fungsi dashboard.
-->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="agent" />
          <add segment="scripts" />
          <add segment="sql" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".ini" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".json" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".rs" allowed="false" />
          <add fileExtension=".toml" allowed="false" />
          <add fileExtension=".lock" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
