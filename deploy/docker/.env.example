# Salin menjadi deploy/docker/.env dan ubah port host sesuai kebutuhan.
# Port internal container tetap 80; hanya port pada mesin Docker yang berubah.
DASHBOARD_PORT=8080

# Default hanya bisa diakses dari mesin Docker. Gunakan IP VPN host untuk
# akses site melalui VPN dan pasang reverse proxy HTTPS.
DASHBOARD_BIND=127.0.0.1
